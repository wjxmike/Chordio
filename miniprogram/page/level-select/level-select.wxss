/* 关卡选择页样式 */

page {
  height: 100vh;
  overflow: hidden;
}

.level-select-container {
  position: relative;
  background-color: #1C1C1C;
  min-height: 100vh;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  padding-top: 100rpx;
  height: 88rpx;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 32rpx;
  height: 32rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-family: '江城圆体', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
  margin-right: 48rpx;
}

/* 关卡卡片列表 */
.level-cards {
  margin-top: 35rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}

.level-card {
  position: relative;
  width: 632rpx;
  height: 412rpx;
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 0 #535353;
  display: flex;
  align-items: center;
  transition: all 0.15s ease;
}

.level-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 0 #535353;
}

/* Level 徽章 */
.level-badge {
  position: absolute;
  left: 58rpx;
  top: 38rpx;
  font-family: 'Fredoka One', sans-serif;
  font-size: 40rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* 关卡信息 */
.level-info {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  text-align: center;
}

.level-name {
  font-family: '江城圆体', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
}

.level-name-en {
  font-family: 'Fredoka One', sans-serif;
  font-size: 32rpx;
  color: #FFFFFF;
  letter-spacing: 1.6rpx;
}

/* 锁定状态 */
.level-card--locked {
  border-color: #535353;
}

.level-card--locked .level-badge,
.level-card--locked .level-name,
.level-card--locked .level-name-en {
  color: #535353;
}

.level-card--locked:active {
  transform: none;
  box-shadow: 0 10rpx 0 #535353;
}

/* 锁图标 */
.lock-icon {
  position: absolute;
  right: 38rpx;
  top: 38rpx;
  width: 40rpx;
  height: 44rpx;
}

.lock-img {
  width: 100%;
  height: 100%;
}
