<view class="profile-container">
  <!-- 设置图标 -->
  <view class="settings-btn" bindtap="onSettingsTap">
    <image class="settings-icon" src="/assets/images/setting.svg" mode="aspectFit"></image>
  </view>

  <!-- 顶部两卡片 -->
  <view class="top-cards">
    <!-- 头像卡片 -->
    <view class="avatar-card" bindtap="onAvatarCardTap">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <text class="username">{{userInfo.nickName}}</text>
    </view>

    <!-- 版本信息卡片 -->
    <view class="version-card">
      <text class="version-text">版本 {{versionLabel}}</text>
      <view class="version-message">
        <text>感谢你的使用</text>
        <text>如果有任何建议</text>
        <text>欢迎提出！</text>
        <text>更多功能持续开发中</text>
      </view>
      <button class="feedback-btn" open-type="contact">留言</button>
    </view>
  </view>

  <!-- Streak 和能量卡片（并排） -->
  <view class="stats-row">
    <view class="streak-card" bindtap="onStreakTap">
      <image class="streak-icon" src="/assets/images/fire-icon.png" mode="aspectFit"></image>
      <text class="streak-number">{{streak}}</text>
      <text class="streak-unit">天</text>
    </view>

    <view class="count-card" bindtap="onCountTap">
      <image class="count-icon" src="/assets/images/lightning.svg" mode="aspectFit"></image>
      <text class="count-number">{{remainingCount}}</text>
      <text class="count-unit">能量</text>
    </view>
  </view>

  <!-- 日历卡片 -->
  <view class="calendar-card">
    <view class="calendar-header">
      <text class="month-cn">{{monthNameCN}}</text>
      <text class="month-en">{{monthNameEN}}</text>
    </view>
    <view class="calendar-grid">
      <view wx:for="{{calendarDays}}" wx:key="index" class="calendar-day {{item.used ? 'calendar-day--used' : ''}}">
        <text class="day-text">{{item.day}}</text>
        <view wx:if="{{item.used}}" class="used-dot"></view>
      </view>
    </view>
  </view>

  <!-- 底部分割线 -->
  <view class="divider"></view>

  <!-- 底部导航栏 -->
  <view class="footer">
    <view class="nav-btn" bindtap="onHomeTap">
      <image class="nav-icon" src="/assets/images/logo-grey.svg" mode="aspectFit"></image>
    </view>
    <view class="nav-btn">
      <image class="nav-icon" src="/assets/images/profile-icon-orange.svg" mode="aspectFit"></image>
    </view>
  </view>
</view>

<!-- 登录/编辑资料弹窗 -->
<view class="login-modal" wx:if="{{showLoginModal}}">
  <view class="login-modal-content">
    <text class="login-title">{{isEditMode ? '编辑资料' : '欢迎使用 Chordiio'}}</text>
    <text class="login-desc">{{isEditMode ? '修改你的头像和昵称' : '请设置你的头像和昵称'}}</text>

    <!-- 头像选择 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-preview" src="{{tempAvatarUrl || userInfo.avatarUrl || '/assets/images/default-avatar.svg'}}" mode="aspectFill"></image>
      <text class="avatar-hint">点击选择头像</text>
    </button>

    <!-- 昵称输入 -->
    <view class="nickname-input-wrapper">
      <input class="nickname-input" type="nickname" placeholder="请输入昵称" value="{{tempNickName}}" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
    </view>

    <!-- 确认按钮 -->
    <button class="login-confirm-btn" bindtap="onConfirmLogin">{{isEditMode ? '保存' : '开始使用'}}</button>

    <!-- 取消/跳过按钮 -->
    <button class="login-cancel-btn" bindtap="onCancelEdit">{{isEditMode ? '取消' : '跳过'}}</button>
  </view>
</view>
