/* Profile 页面样式 */

page {
  height: 100vh;
  overflow: hidden;
  background-color: #1C1C1C;
}

.profile-container {
  position: relative;
  background-color: #1C1C1C;
  height: 100vh;
  padding: 0 48rpx;
  padding-bottom: 160rpx;  /* 为底部导航栏留空间 */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow-y: auto;  /* 内容过多时可滚动 */
}

/* 设置图标 */
.settings-btn {
  position: absolute;
  left: 48rpx;
  top: 105rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.settings-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 顶部两卡片 */
.top-cards {
  display: flex;
  justify-content: space-between;
  gap: 40rpx;
  margin-top: 180rpx;
  flex-shrink: 0;
}

/* 头像卡片 - 宽度自适应 */
.avatar-card {
  flex: 1;
  min-width: 280rpx;
  max-width: 360rpx;
  height: 300rpx;
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 50rpx;
  box-sizing: border-box;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #535353;
}

.username {
  margin-top: 20rpx;
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 24rpx;
  color: #FFFFFF;
  letter-spacing: 1.2rpx;
}

/* 版本信息卡片 - 宽度自适应 */
.version-card {
  flex: 1;
  min-width: 280rpx;
  max-width: 360rpx;
  height: 300rpx;
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 50rpx;
  box-sizing: border-box;
}

.version-text {
  font-family: '江城圆体', sans-serif;
  font-size: 22rpx;
  color: #9A9A9A;
  letter-spacing: 1.1rpx;
}

.version-message {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.version-message text {
  font-family: '江城圆体', sans-serif;
  font-size: 18rpx;
  color: #9A9A9A;
  letter-spacing: 0.9rpx;
}

.feedback-btn {
  margin-top: 12rpx;
  width: 90rpx;
  height: 44rpx;
  background-color: #353535;
  border: 2rpx solid #535353;
  border-radius: 20rpx;
  font-family: '江城圆体', sans-serif;
  font-size: 22rpx;
  color: #9A9A9A;
  letter-spacing: 1.1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.feedback-btn::after {
  border: none;
}

/* Streak 和能量卡片并排 */
.stats-row {
  display: flex;
  justify-content: space-between;
  gap: 40rpx;
  margin-top: 40rpx;
  flex-shrink: 0;
}

/* Streak 卡片 - 宽度自适应 */
.streak-card {
  flex: 1;
  min-width: 280rpx;
  max-width: 360rpx;
  height: 300rpx;
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.streak-icon {
  width: 64rpx;
  height: 64rpx;
}

.streak-number {
  font-family: 'Fredoka One', sans-serif;
  font-size: 64rpx;
  color: #FFFFFF;
  letter-spacing: 3.2rpx;
  margin-left: 10rpx;
}

.streak-unit {
  font-family: '江城圆体', sans-serif;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 1.4rpx;
  margin-left: 12rpx;
  align-self: flex-end;
  margin-bottom: 100rpx;
}

/* 剩余能量卡片 - 宽度自适应 */
.count-card {
  flex: 1;
  min-width: 280rpx;
  max-width: 360rpx;
  height: 300rpx;
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.count-icon {
  width: 52rpx;
  height: 52rpx;
}

.count-number {
  font-family: 'Fredoka One', sans-serif;
  font-size: 64rpx;
  color: #FFFFFF;
  letter-spacing: 3.2rpx;
  margin-left: 10rpx;
}

.count-unit {
  font-family: '江城圆体', sans-serif;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 1.4rpx;
  margin-left: 12rpx;
  align-self: flex-end;
  margin-bottom: 100rpx;
}

/* 日历卡片 - 宽度自适应 */
.calendar-card {
  margin-top: 40rpx;
  flex: 1;
  min-height: 380rpx;
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.calendar-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.month-cn {
  font-family: '江城圆体', sans-serif;
  font-size: 40rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.month-en {
  font-family: 'Fredoka One', sans-serif;
  font-size: 32rpx;
  color: #FFFFFF;
  letter-spacing: 1.6rpx;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx 38rpx;
}

.calendar-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 56rpx;
  position: relative;
}

.day-text {
  font-family: 'Fredoka One', sans-serif;
  font-size: 32rpx;
  color: #FFFFFF;
  letter-spacing: 1.6rpx;
}

.calendar-day--used .day-text {
  color: #FF7A15;
}

.used-dot {
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  background-color: #FF7A15;
  border-radius: 50%;
}

/* 底部分割线 */
.divider {
  position: fixed;
  bottom: 158rpx;
  left: 48rpx;
  right: 48rpx;
  height: 2rpx;
  background-color: #535353;
}

/* 底部导航栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 250rpx;
  padding-bottom: 60rpx;
  background-color: #1C1C1C;
}

.nav-btn {
  width: 56rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  width: 56rpx;
  height: 78rpx;
}

/* ========== 登录弹窗 ========== */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.login-modal-content {
  width: 600rpx;
  background-color: #2C2C2C;
  border: 4rpx solid #535353;
  border-radius: 24rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.login-title {
  font-family: 'Fredoka One', sans-serif;
  font-size: 40rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.login-desc {
  font-family: '江城圆体', sans-serif;
  font-size: 26rpx;
  color: #9A9A9A;
  margin-top: 16rpx;
  letter-spacing: 1.3rpx;
}

/* 头像选择按钮 */
.avatar-btn {
  margin-top: 40rpx;
  background: transparent;
  border: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #535353;
}

.avatar-hint {
  font-family: '江城圆体', sans-serif;
  font-size: 24rpx;
  color: #9A9A9A;
  margin-top: 16rpx;
  letter-spacing: 1.2rpx;
}

/* 昵称输入 */
.nickname-input-wrapper {
  margin-top: 32rpx;
  width: 100%;
}

.nickname-input {
  width: 100%;
  height: 88rpx;
  background-color: #353535;
  border: 2rpx solid #535353;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-family: '江城圆体', sans-serif;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 1.4rpx;
  box-sizing: border-box;
}

.nickname-input::placeholder {
  color: #666666;
}

/* 确认按钮 */
.login-confirm-btn {
  margin-top: 40rpx;
  width: 100%;
  height: 80rpx;
  background-color: #FF7A15;
  border: none;
  border-radius: 16rpx;
  font-family: '江城圆体', sans-serif;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 1.4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.login-confirm-btn::after {
  border: none;
}
