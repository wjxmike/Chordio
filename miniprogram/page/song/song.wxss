/* Chord Hero - 歌曲模式样式 */

page {
  height: 100vh;
  overflow: hidden;
}

.song-container {
  position: relative;
  background-color: #1C1C1C;
  height: 100vh;
  padding: 0 72rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部：练习进度条 + 题号 */
.header-row {
  display: flex;
  align-items: center;
  margin-top: 50rpx;
}

.practice-progress-bar {
  width: 606rpx;
  height: 20rpx;
  background-color: #353535;
  border-radius: 17rpx;
  overflow: hidden;
}

.practice-progress-fill {
  height: 100%;
  background-color: #FF7A15;
  border-radius: 17rpx;
  transition: width 0.3s ease;
}

.question-number {
  margin-left: 24rpx;
  font-family: 'Protest Strike', sans-serif;
  font-size: 28rpx;
  color: #FFFFFF;
  letter-spacing: 1.2rpx;
}

/* 歌曲卡片 */
.song-card {
  margin-top: 46rpx;
  display: flex;
  align-items: center;
  height: 220rpx;
  border: 5rpx solid #535353;
  border-radius: 16rpx;
  padding-right: 12rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.song-cover {
  width: 210rpx;
  height: 215rpx;
  border-radius: 11rpx 12rpx 12rpx 11rpx;
  flex-shrink: 0;
}

.song-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.song-title {
  font-family: '江城圆体', sans-serif;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1.2rpx;
}

.song-artist {
  font-family: '江城圆体', sans-serif;
  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  letter-spacing: 0.7rpx;
  margin-top: 8rpx;
}

.play-btn {
  width: 70rpx;
  height: 70rpx;
  background-color: #FF7A15;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 30rpx;
  box-shadow: 0 6rpx 0 rgba(208, 107, 30, 0.35);
}

.play-btn--playing {
  background-color: #FF7A15;
}

.play-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 歌曲播放进度条（细条） */
.song-progress-bar {
  margin-top: -16rpx;
  margin-bottom: -16rpx;
  padding: 16rpx 0;
  margin-left: 10rpx;
  margin-right: 10rpx;
  position: relative;
}

.song-progress-track {
  height: 8rpx;
  background-color: #353535;
  border-radius: 6rpx;
  overflow: visible;
  position: relative;
}

.song-progress-fill {
  height: 100%;
  background-color: #FF7A15;
  border-radius: 6rpx;
  transition: width 0.1s linear;
}

.song-progress-handle {
  position: absolute;
  top: 50%;
  width: 24rpx;
  height: 24rpx;
  background-color: #FF7A15;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0;
  transition: opacity 0.15s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  pointer-events: none;
}

.song-progress-handle--visible {
  opacity: 1;
}

/* 和弦方块 */
.chord-blocks-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 22rpx;
  margin-top: 30rpx;
}

/* 根据和弦数量调整方块尺寸 - 统一高度 162rpx */
.chord-blocks-row--2 .chord-block { width: 152rpx; }
.chord-blocks-row--3 .chord-block { width: 128rpx; }
.chord-blocks-row--4 .chord-block { width: 152rpx; }
.chord-blocks-row--5 .chord-block { width: 112rpx; }

.chord-block {
  height: 150rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 6rpx 0 rgba(83, 83, 83, 0.35);
  box-sizing: border-box;
}

.chord-block--filled {
  background-color: #535353;
}

.chord-block--blank {
  background-color: #1C1C1C;
  border: 3rpx solid #535353;
  box-shadow: 0 6rpx 0 rgba(83, 83, 83, 0.35);
}

.chord-block--correct {
  background-color: #78C04B;
  border: none;
  box-shadow: 0 6rpx 0 rgba(120, 192, 75, 0.35);
}

.chord-block--wrong {
  background-color: #1C1C1C;
  border: 3rpx solid #FF7A15;
  box-shadow: 0 6rpx 0 rgba(208, 107, 30, 0.35);
}

.chord-block-text {
  font-family: 'Protest Strike', sans-serif;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 1.2rpx;
}

/* 答题选项 2×2 - 大卡片 */
.options-grid {
  display: grid;
  grid-template-columns: 266rpx 266rpx;
  justify-content: center;
  gap: 34rpx 50rpx;
  margin-top: 40rpx;
}

.option-card {
  background-color: #1C1C1C;
  border: 3rpx solid #535353;
  border-radius: 20rpx;
  width: 266rpx;
  height: 292rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  box-shadow: 0 8rpx 0 rgba(83, 83, 83, 0.35);
}

.option-card--selected {
  border-color: #FF7A15;
  border-width: 3rpx;
}

.option-card--hover {
  border-color: #FF7A15;
  border-width: 3rpx;
}

.option-card--correct {
  background-color: #78C04B;
  border-color: #78C04B;
  box-shadow: 0 8rpx 0 rgba(120, 192, 75, 0.35);
}

.option-text {
  font-family: 'Protest Strike', sans-serif;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
}

/* 底部按钮 */
.bottom-btn {
  margin-top: auto;
  margin-bottom: 100rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: #535353;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
}

.bottom-btn--correct {
  background-color: #78C04B;
  box-shadow: 0 10rpx 0 rgba(120, 192, 75, 0.35);
}

.bottom-btn--confirm {
  background-color: #FF7A15;
  box-shadow: 0 10rpx 0 rgba(255, 122, 21, 0.35);
}

.bottom-btn--wrong {
  background-color: #1C1C1C;
  border: 3rpx solid #FF7A15;
  box-shadow: 0 10rpx 0 rgba(208, 107, 30, 0.35);
}

.root-note-text {
  font-family: 'Fredoka One', sans-serif;
  color: #FFFFFF;
  font-size: 52rpx;
  font-weight: 400;
  letter-spacing: 2.4rpx;
}

.bottom-btn-text {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}
