/* 首页 + 启动页样式 */

page {
  height: 100vh;
  overflow: hidden;
  background-color: #1C1C1C;
}

/* 通用显示/隐藏 */
.visible {
  opacity: 1;
}

.hidden {
  opacity: 0;
  pointer-events: none;
}

/* ========== 启动页 ========== */
.splash-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #1C1C1C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.3s ease;
  z-index: 100;
}

.logo-wrapper {
  width: 164rpx;
  height: 196rpx;
  margin-bottom: 50rpx;
}

.logo {
  width: 100%;
  height: 100%;
}

.app-name-splash {
  font-family: 'Fredoka One', sans-serif;
  font-size: 64rpx;
  color: #FFFFFF;
  letter-spacing: 3.2rpx;
  text-align: center;
}

.app-name-splash.visible {
  animation: fadeInUp 0.6s ease-out 0.2s both;
}

.slogan {
  font-family: '江城圆体', sans-serif;
  font-size: 32rpx;
  color: #FFFFFF;
  letter-spacing: 1.6rpx;
  text-align: center;
  margin-top: 24rpx;
}

.slogan.visible {
  animation: fadeInUp 0.6s ease-out 0.4s both;
}

/* 文字从下向上淡入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 首页 ========== */
.home-container {
  background-color: #1C1C1C;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transition: opacity 0.3s ease;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  margin-top: 100rpx;
  margin-left: 42rpx;
  gap: 8rpx;
}

.app-name {
  font-family: 'Fredoka One', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
}

.streak-icon {
  width: 50rpx;
  height: 50rpx;
  margin-left: 170rpx;
}

.streak-number {
  font-family: 'Fredoka One', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
}

/* 模式卡片容器 */
.cards-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 40rpx;
  padding-top: 30rpx;
}

/* 模式卡片 */
.mode-card {
  width: 632rpx;
  height: 364rpx;
  border-radius: 20rpx;
  border: 4rpx solid #535353;
  background-color: #1C1C1C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0rpx 10rpx 0rpx 0rpx rgba(83, 83, 83, 0.5);
  transition: all 0.15s ease;
}

.mode-card--hover {
  transform: scale(0.98);
}

/* 选中状态（橙色高亮）*/
.mode-card--active {
  border-color: #D06B1E;
  box-shadow: 0rpx 10rpx 0rpx 0rpx rgba(208, 107, 30, 0.5);
}

.card-title-en {
  font-family: 'Fredoka One', sans-serif;
  font-size: 40rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.card-title-cn {
  font-family: '江城圆体', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
  margin-top: 8rpx;
}

/* 分割线 */
.divider {
  width: 100%;
  height: 2rpx;
  background-color: #535353;
  margin-bottom: 20rpx;
}

/* 底部导航栏 */
.footer {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 250rpx;
  padding-bottom: 60rpx;
}

.nav-btn {
  width: 56rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  width: 56rpx;
  height: 78rpx;
}
