/* 首页 + 启动页样式 */

page {
  height: 100vh;
  overflow: hidden;
  background-color: #1C1C1C;
}

/* 通用显示/隐藏 */
.visible {
  opacity: 1;
}

.hidden {
  opacity: 0;
  pointer-events: none;
}

/* ========== 启动页 ========== */
.splash-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #1C1C1C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: opacity 0.3s ease;
  z-index: 100;
}

.logo-wrapper {
  width: 164rpx;
  height: 196rpx;
  margin-bottom: 50rpx;
}

.logo {
  width: 100%;
  height: 100%;
}

.app-name-splash {
  font-family: 'Fredoka One', sans-serif;
  font-size: 64rpx;
  color: #FFFFFF;
  letter-spacing: 3.2rpx;
  text-align: center;
}

.app-name-splash.visible {
  animation: fadeInUp 0.6s ease-out 0.2s both;
}

.slogan {
  font-family: '江城圆体', sans-serif;
  font-size: 32rpx;
  color: #FFFFFF;
  letter-spacing: 1.6rpx;
  text-align: center;
  margin-top: 24rpx;
}

.slogan.visible {
  animation: fadeInUp 0.6s ease-out 0.4s both;
}

/* 文字从下向上淡入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 首页 ========== */
.home-container {
  background-color: #1C1C1C;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transition: opacity 0.3s ease;
}

/* 顶部标题栏 */
.header {
  display: flex;
  align-items: center;
  margin-top: 106rpx;
  margin-left: 42rpx;
  gap: 8rpx;
}

.app-name {
  font-family: 'Fredoka One', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
}

.streak-icon {
  width: 50rpx;
  height: 50rpx;
}

.streak-number {
  font-family: 'Fredoka One', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
}

.streak-area {
  display: flex;
  align-items: center;
  margin-left: 80rpx;
}

.count-icon {
  width: 44rpx;
  height: 44rpx;
}

.count-number {
  font-family: 'Fredoka One', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
}

.count-area {
  display: flex;
  align-items: center;
  margin-left: 30rpx;
}

/* 模式卡片容器 */
.cards-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 40rpx;
  padding-top: 45rpx;
  padding-left: 60rpx;
  padding-right: 60rpx;
  box-sizing: border-box;
}

/* 顶部两卡片并排 */
.cards-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  gap: 40rpx;
}

/* 模式卡片 - 通用 */
.mode-card {
  border-radius: 20rpx;
  border: 4rpx solid #535353;
  background-color: #1C1C1C;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0rpx 10rpx 0rpx 0rpx rgba(83, 83, 83, 0.5);
  transition: all 0.15s ease;
  position: relative;
  overflow: hidden;
}

/* 小卡片 (Practice & Challenge) */
.mode-card--small {
  flex: 1;
  height: 364rpx;
}

.mode-card--small .card-title-en {
  font-size: 35rpx;
}

.mode-card--small .card-title-cn {
  font-size: 43rpx;
}

/* 大卡片 (Songs) - 填充剩余空间 */
.mode-card--large {
  width: 100%;
  flex: 1;
  margin-bottom: 220rpx;  /* 为底部导航栏留空间 */
}

.mode-card--hover {
  transform: scale(0.98);
}

/* 选中状态（橙色高亮）*/
.mode-card--active {
  border-color: #D06B1E;
  box-shadow: 0rpx 10rpx 0rpx 0rpx rgba(208, 107, 30, 0.5);
}

/* 歌曲模式背景图 - 填充整个卡片 */
.songs-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.15;
  pointer-events: none;
}

/* 歌曲模式内容 */
.songs-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.card-title-en {
  font-family: 'Fredoka One', sans-serif;
  font-size: 40rpx;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.card-title-cn {
  font-family: '江城圆体', sans-serif;
  font-size: 48rpx;
  color: #FFFFFF;
  letter-spacing: 2.4rpx;
  margin-top: 8rpx;
}

/* 分割线 */
.divider {
  position: fixed;
  bottom: 158rpx;
  left: 48rpx;
  right: 48rpx;
  height: 2rpx;
  background-color: #535353;
}

/* 底部导航栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 250rpx;
  padding-bottom: 60rpx;
  background-color: #1C1C1C;
}

.nav-btn {
  width: 56rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  width: 56rpx;
  height: 78rpx;
}

/* 测试入口 */
.test-entry {
  position: fixed;
  bottom: 20rpx;
  right: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 122, 21, 0.8);
  border-radius: 20rpx;
}

.test-entry-text {
  font-size: 24rpx;
  color: #fff;
}

/* ========== 奖励浮窗 ========== */
.bonus-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  background: rgba(0, 0, 0, 0.75);
  border-radius: 24rpx;
  padding: 40rpx 60rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 1000;
}

.bonus-toast--show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.bonus-toast-icon {
  width: 64rpx;
  height: 64rpx;
}

.bonus-toast-text {
  font-family: 'Fredoka One', sans-serif;
  font-size: 56rpx;
  color: #FF7A15;
  letter-spacing: 2.8rpx;
}

/* ========== 更新公告浮窗 ========== */
.update-notice {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  z-index: 2000;
}

.update-notice--show {
  opacity: 1;
  pointer-events: auto;
}

.update-notice-content {
  width: 600rpx;
  max-height: 80vh;
  background: #2A2A2A;
  border-radius: 32rpx;
  border: 4rpx solid #535353;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.update-notice-header {
  padding: 40rpx 40rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #3A3A3A;
}

.update-notice-title {
  font-family: '江城圆体', sans-serif;
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.update-notice-version {
  font-family: 'Fredoka One', sans-serif;
  font-size: 28rpx;
  color: #FF7A15;
  background: rgba(255, 122, 21, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.update-notice-body {
  flex: 1;
  padding: 32rpx 40rpx;
  height: 50vh;
  box-sizing: border-box;
}

.update-section {
  margin-bottom: 32rpx;
}

.update-section:last-child {
  margin-bottom: 0;
}

.update-section-title {
  font-family: '江城圆体', sans-serif;
  font-size: 30rpx;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  display: block;
}

.update-item {
  font-family: '江城圆体', sans-serif;
  font-size: 26rpx;
  color: #AAAAAA;
  line-height: 1.8;
  display: block;
  padding-left: 20rpx;
  word-wrap: break-word;
  word-break: break-all;
  white-space: normal;
}

.update-notice-footer {
  padding: 24rpx 40rpx 40rpx;
  border-top: 2rpx solid #3A3A3A;
}

.update-notice-btn {
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FF7A15;
  border-radius: 16rpx;
  font-family: '江城圆体', sans-serif;
  font-size: 32rpx;
  color: #FFFFFF;
}
