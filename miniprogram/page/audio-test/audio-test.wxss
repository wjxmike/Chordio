.container {
  padding: 30rpx;
  background: #1C1C1C;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #888;
}

/* 状态面板 */
.status-panel {
  background: #2a2a2a;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid #3a3a3a;
}

.status-row:last-child {
  border-bottom: none;
}

.label {
  color: #888;
  font-size: 28rpx;
}

.value {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.value.success {
  color: #78C04B;
}

.value.warning {
  color: #FF7A15;
}

.value.playing {
  color: #4CAF50;
}

/* 分区 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #FF7A15;
}

/* 按钮组 */
.btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.btn {
  flex: 1;
  min-width: 45%;
  background: #535353;
  color: #fff;
  font-size: 26rpx;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.8;
}

.btn.primary {
  background: #FF7A15;
}

.btn.warning {
  background: #e67e22;
}

.btn.danger {
  background: #c0392b;
}

.btn.success {
  background: #27ae60;
}

/* 日志面板 */
.log-panel {
  margin-top: 40rpx;
  background: #2a2a2a;
  border-radius: 16rpx;
  overflow: hidden;
}

.log-title {
  display: block;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  background: #333;
  border-bottom: 1px solid #444;
}

.log-scroll {
  height: 400rpx;
  padding: 20rpx;
}

.log-item {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #ccc;
  font-family: monospace;
  word-break: break-all;
}

.log-item.error {
  color: #e74c3c;
}

.log-item.error text {
  color: #e74c3c;
}
