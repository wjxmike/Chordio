/* Chord Hero - 挑战页样式 */

page {
  height: 100vh;
  overflow: hidden;
}

.challenge-container {
  position: relative;
  background-color: #1C1C1C;
  height: 100vh;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部状态行：生命值 + 分数 */
.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 65rpx;
}

.hearts {
  display: flex;
  gap: 12rpx;
}

.heart-icon {
  width: 46rpx;
  height: 38rpx;
}

.score-display {
  display: flex;
  align-items: center;
}

.score-label {
  font-family: '江城圆体', sans-serif;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2.4rpx;
}

.score-value {
  font-family: 'Fredoka One', sans-serif;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 2.4rpx;
  margin-left: 8rpx;
}

/* 倒计时进度条 */
.timer-bar-bg {
  margin-top: 24rpx;
  height: 20rpx;
  background-color: #353535;
  border-radius: 17rpx;
  overflow: hidden;
}

.timer-bar-fill {
  height: 100%;
  background-color: #FF7A15;
  border-radius: 17rpx;
  transition: width 1s linear;
}

/* 和弦方块 */
.chord-blocks-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 22rpx;
  margin-top: 40rpx;
}

.chord-block {
  width: 152rpx;
  height: 162rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 8rpx 0 rgba(83, 83, 83, 0.35);
  box-sizing: border-box;
}

.chord-block--filled {
  background-color: #535353;
}

.chord-block--blank {
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  box-shadow: 0 8rpx 0 rgba(83, 83, 83, 0.35);
}

.chord-block--correct {
  background-color: #78C04B;
  border: none;
  box-shadow: 0 8rpx 0 rgba(120, 192, 75, 0.35);
}

.chord-block--wrong {
  background-color: #1C1C1C;
  border: 4rpx solid #FF7A15;
  box-shadow: 0 8rpx 0 rgba(208, 107, 30, 0.35);
}

.chord-block-text {
  font-family: 'Protest Strike', sans-serif;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 2.4rpx;
}

/* 答题选项 2×2 */
.options-grid {
  display: grid;
  grid-template-columns: 266rpx 266rpx;
  justify-content: center;
  gap: 34rpx 50rpx;
  margin-top: 40rpx;
}

.option-card {
  background-color: #1C1C1C;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  width: 266rpx;
  height: 340rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  box-shadow: 0 10rpx 0 rgba(83, 83, 83, 0.35);
}

.option-card--selected {
  border-color: #FF7A15;
  border-width: 4rpx;
}

.option-card--hover {
  border-color: #FF7A15;
  border-width: 4rpx;
}

.option-card--correct {
  background-color: #78C04B;
  border-color: #78C04B;
  box-shadow: 0 10rpx 0 rgba(120, 192, 75, 0.35);
}

.option-text {
  font-family: 'Protest Strike', sans-serif;
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 400;
  letter-spacing: 2.4rpx;
}

/* 底部按钮：根音 */
.bottom-btn {
  margin-top: 40rpx;
  margin-bottom: 50rpx;
  height: 120rpx;
  border-radius: 20rpx;
  background-color: #535353;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-shadow: 0 12rpx 0 rgba(83, 83, 83, 0.35);
}

.bottom-btn--correct {
  background-color: #78C04B;
  box-shadow: 0 12rpx 0 rgba(120, 192, 75, 0.35);
}

.bottom-btn--confirm {
  background-color: #FF7A15;
  box-shadow: 0 12rpx 0 rgba(255, 122, 21, 0.35);
}

.bottom-btn--wrong {
  background-color: #1C1C1C;
  border: 4rpx solid #FF7A15;
  box-shadow: 0 12rpx 0 rgba(208, 107, 30, 0.35);
}

.root-note-text {
  font-family: 'Fredoka One', sans-serif;
  color: #FFFFFF;
  font-size: 50rpx;
  font-weight: 400;
  letter-spacing: 3.2rpx;
}

.bottom-btn-text {
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
}
