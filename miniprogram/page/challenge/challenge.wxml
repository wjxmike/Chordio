<wxs src="../../utils/chord-format.wxs" module="chordFmt" />
<view class="challenge-container">
  <!-- 顶部状态栏：生命值 + 分数 -->
  <view class="status-row">
    <view class="hearts">
      <image wx:for="{{hearts}}" wx:key="index" class="heart-icon" src="{{item ? '/assets/images/heart.svg' : '/assets/images/hollow-heart.svg'}}" mode="aspectFit"></image>
    </view>
    <view class="score-display">
      <text class="score-label">分数:</text>
      <text class="score-value">{{score}}</text>
    </view>
  </view>

  <!-- 倒计时进度条 -->
  <view class="timer-bar-bg">
    <view class="timer-bar-fill" style="width: {{(timer / maxTime) * 100}}%"></view>
  </view>

  <!-- 和弦方块 -->
  <view class="chord-blocks-row">
    <view wx:for="{{progression}}" wx:key="index" class="chord-block {{item.isBlank ? (pageState === 'correct' || item.isUserCorrect ? 'chord-block--correct' : (pageState === 'wrong' && !item.isUserCorrect ? 'chord-block--wrong' : 'chord-block--blank')) : 'chord-block--filled'}}" data-index="{{index}}" bindtap="onBlockTap">
      <rich-text wx:if="{{!item.isBlank}}" class="chord-block-text" nodes="{{chordFmt.getNodes(item.symbol)}}"></rich-text>
      <rich-text wx:elif="{{pageState === 'correct'}}" class="chord-block-text" nodes="{{chordFmt.getNodes(item.answer)}}"></rich-text>
      <rich-text wx:elif="{{pageState === 'wrong'}}" class="chord-block-text" nodes="{{chordFmt.getNodes(item.answer)}}"></rich-text>
      <rich-text wx:elif="{{item.userAnswer}}" class="chord-block-text" nodes="{{chordFmt.getNodes(item.userAnswer)}}"></rich-text>
    </view>
  </view>

  <!-- 答题选项 2×2 -->
  <view class="options-grid">
    <view wx:for="{{options}}" wx:key="index" class="option-card {{flashingIndex === index ? 'option-card--selected' : ''}} {{pageState === 'correct' && correctAnswers.indexOf(item) >= 0 ? 'option-card--correct' : ''}}" hover-class="{{pageState === 'playing' || pageState === 'correct' || pageState === 'wrong' ? '' : 'option-card--hover'}}" hover-stay-time="100" data-index="{{index}}" bindtap="onOptionSelect">
      <rich-text class="option-text" nodes="{{chordFmt.getNodes(item)}}"></rich-text>
    </view>
  </view>

  <!-- 底部按钮：根音 -->
  <view class="bottom-btn {{pageState === 'correct' ? 'bottom-btn--correct' : ''}} {{pageState === 'selected' ? 'bottom-btn--confirm' : ''}} {{pageState === 'wrong' ? 'bottom-btn--wrong' : ''}}" bindtap="{{pageState === 'correct' || pageState === 'wrong' ? 'onNextQuestion' : 'onBottomButtonTap'}}">
    <block wx:if="{{pageState === 'playing'}}">
      <text class="root-note-text" style="opacity: 0;">{{rootNote}}</text>
    </block>
    <block wx:elif="{{pageState === 'idle'}}">
      <text class="root-note-text">{{rootNote}}</text>
    </block>
    <block wx:elif="{{pageState === 'selected'}}">
      <text class="bottom-btn-text">确认</text>
    </block>
    <block wx:else>
      <text class="bottom-btn-text">下一题</text>
    </block>
  </view>
</view>

<share-modal
  show="{{showShareModal}}"
  title="{{shareModalTitle}}"
  message="{{shareModalMessage}}"
  cancel-text="{{shareModalCancelText}}"
  bind:cancel="onShareModalCancel"
  bind:share="onShareModalShare"
/>
