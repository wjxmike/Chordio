/* 版本日志页面样式 */

page {
  height: 100vh;
  overflow: hidden;
  background-color: #1C1C1C;
}

.changelog-container {
  background-color: #1C1C1C;
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

/* 版本列表 */
.changelog-list {
  flex: 1;
  height: 100vh;
  padding: 40rpx 50rpx;
  box-sizing: border-box;
}

.version-card {
  background-color: #2A2A2A;
  border: 4rpx solid #535353;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.version-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #3A3A3A;
}

.version-number {
  font-family: 'Fredoka One', sans-serif;
  font-size: 36rpx;
  color: #FFFFFF;
  letter-spacing: 1.8rpx;
}

.version-date {
  font-family: '江城圆体', sans-serif;
  font-size: 24rpx;
  color: #666666;
  margin-left: 24rpx;
}

.version-badge {
  font-family: '江城圆体', sans-serif;
  font-size: 22rpx;
  color: #FFFFFF;
  background-color: #FF7A15;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
}

/* 更新分区 */
.update-section {
  margin-top: 24rpx;
}

.update-section:first-of-type {
  margin-top: 0;
}

.section-title {
  font-family: '江城圆体', sans-serif;
  font-size: 28rpx;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  display: block;
}

.section-item {
  font-family: '江城圆体', sans-serif;
  font-size: 26rpx;
  color: #AAAAAA;
  line-height: 1.8;
  display: block;
  padding-left: 16rpx;
  word-wrap: break-word;
  word-break: break-all;
}
